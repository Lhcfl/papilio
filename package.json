{
  "name": "papilio",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Lhcfl/papilio"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsrs -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:reuse": "pipx run reuse lint",
    "licence:annotate": "node dev-scripts/add-licence-header.js",
    "licence:check": "node dev-scripts/add-licence-header.js --test",
    "update-locales": "bun dev-scripts/update-locale.ts",
    "proj:line-count": "tokei src -e ui -e *.gen.ts",
    "test:pre-commit": "pnpm licence:check",
    "test:pre-push": "run-p test:pre-commit typecheck lint",
    "preview": "vite preview",
    "prepare": "node .husky/install.mjs"
  },
