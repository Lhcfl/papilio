		"update-locales": "bun dev-scripts/update-locale.ts",
		"proj:line-count": "tokei src -e ui -e *.gen.ts",
		"test:pre-commit": "pnpm licence:check",
		"test:pre-push": "run-p test:pre-commit typecheck lint",
		"preview": "vite preview",
